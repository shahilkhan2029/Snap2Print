# ==============================================================================
# Snap2Print - .gitignore
# ==============================================================================

# Python Virtual Environments
.venv/
venv/
ENV/
env/
*.venv/

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
.tox/

# Packaging & Build Outputs (Standalone executables and compiler caches)
build/
dist/
*.egg-info/
*.zip

# Local Storage & Runtime User Session Data
# (Ensures zero customer photos, segmented masks, or exports are committed)
input/*
!input/.gitkeep
output/*
!output/.gitkeep

# AI Model Weights & Cache Directories
# (Weights download automatically at runtime; avoids committing gigabyte binaries)
models/*
!models/.gitkeep

# Environment & Secrets (Never commit credentials or tokens)
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt
secrets/

# Databases
*.sqlite
*.sqlite3
*.db

# Logs & Temporary Files
*.log
logs/
temp/
tmp/
scratch/

# IDE & Editor Configurations
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# Operating System Artifacts
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
